<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Laya is self-hosted (laya-serve); allow plain HTTP to local/LAN dev servers. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
